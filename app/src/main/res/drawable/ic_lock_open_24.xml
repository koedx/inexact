<!--
  Open padlock, drawn for this app so that "open" cannot be misread: the shackle (the U shaped bar)
  is swung out to the side with its free end clear of the body, instead of merely lifted a little.
  Lock action in the top bar: it shows the current state (unlocked); pressing it locks.
  Created:  2026-11-06 09:27:32 UTC
  Modified: 2026-11-10 09:00:00 UTC
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <!-- Body: sits low and to the left so the swung-out shackle has room on the right. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M5,10h8a2,2 0 0 1 2,2v7a2,2 0 0 1 -2,2H5a2,2 0 0 1 -2,-2v-7a2,2 0 0 1 2,-2z" />
    <!-- Shackle: one leg still in the body, the arch swung out past its right edge, and the free
         leg ending in mid air. That gap is what says "open". -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,10V6.5a4.5,4.5 0 0 1 9,0V9" />
    <!-- Keyhole. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M9,14a1.5,1.5 0 1 0 0,3a1.5,1.5 0 1 0 0,-3z" />
</vector>
