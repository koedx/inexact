<!-- NOTE: the package="com.android.calculator2" attribute was removed; under
     AGP 8 the package/namespace is declared in app/build.gradle (namespace),
     and the installed id is set there via applicationId. -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- InExact: the session service (below) is a foreground service. Normal permission, granted
         at install with no prompt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_calculator"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".Calculator"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Calculator"
            android:exported="true">
            <layout
                android:minHeight="220dp"
                android:minWidth="230dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALCULATOR" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Licenses"
            android:launchMode="singleTop"
            android:parentActivityName=".Calculator"
            android:theme="@style/Theme.Licenses"
            android:exported="false" />

        <!-- InExact: provisioning entry point (scripted PIN config, spec §8 path a).
             Exported but guarded by the DUMP permission — a permission only the shell
             holds, which a third-party app cannot declare or hold — and with NO
             intent-filter, so it is reachable only by explicit component name from the
             shell. (Non-exported does NOT work on this ROM: the shell is denied
             "not exported from uid ...".) The inner access check is the arming marker,
             verified inside the activity. -->
        <activity
            android:name=".gate.ProvisionActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- InExact: the unlocked surface (app picker, settings, admin). Reached only through the
             gate: NOT exported, no intent-filter, and it finishes at once unless a session is
             active. Labelled like the app so recents shows the calculator's name, not a new one.
             configChanges: rotation etc. must not recreate it. -->
        <activity
            android:name=".gate.LauncherActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.Hidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|fontScale|uiMode|layoutDirection"
            android:exported="false" />

        <!-- InExact: keeps a signed-in session alive and reachable (spec addendum 2026-11-09-01
             §9). Runs only while a session is open; never started on an unprovisioned install.
             Not exported: only this app can start it or send it the Lock action. -->
        <service
            android:name=".gate.SessionService"
            android:exported="false" />

    </application>
</manifest>
